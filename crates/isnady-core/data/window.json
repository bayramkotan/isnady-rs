 "grade_terms": {
  "en": {
   "4": "sahih (صحيح): A hadith with an unbroken chain of trustworthy narrators of sound memory, free of irregularity (shudhudh) and hidden defect ('illa).",
   "3": "hasan (حسن): Like a sahih hadith, except that a narrator's memory is somewhat less precise.",
   "2": "da'if (ضعيف): A hadith that lacks one or more of the conditions of hasan.",
   "1": "da'if (ضعيف): A hadith that lacks one or more of the conditions of hasan.",
   "0": "mawdu' (موضوع): A fabricated report falsely attributed to the Prophet."
  },
  "tr": {
   "4": "sahîh (صحيح): Senedi kesintisiz, ravileri adil ve zabtı tam, şâz ve illetten uzak hadis.",
   "3": "hasen (حسن): Sahih gibi, ancak bir ravisinin zabtı tam derecede olmayan hadis.",
   "2": "zayıf (ضعيف): Hasen hadisin şartlarından birini ya da birkaçını taşımayan hadis.",
   "1": "zayıf (ضعيف): Hasen hadisin şartlarından birini ya da birkaçını taşımayan hadis.",
   "0": "mevzû (موضوع): Peygambere yalan olarak isnat edilmiş, uydurma rivayet."
  },
  "ar": {
   "4": "صحيح (صحيح): ما اتصل سنده بنقل العدل الضابط عن مثله إلى منتهاه، من غير شذوذ ولا علة.",
   "3": "حسن (حسن): كالصحيح إلا أن أحد رواته أخفّ ضبطًا.",
   "2": "ضعيف (ضعيف): ما فقد شرطًا أو أكثر من شروط الحسن.",
   "1": "ضعيف (ضعيف): ما فقد شرطًا أو أكثر من شروط الحسن.",
   "0": "موضوع (موضوع): المختلق المكذوب المنسوب إلى النبي ﷺ."
  }
 },
