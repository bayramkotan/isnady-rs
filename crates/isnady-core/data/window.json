  "role_help": {
   "compiler": [
    "Compiler (musannif)",
    "A scholar who gathered hadith into a book, each with the chain he heard it through. The first link of every chain is his own teacher; the last is usually the Companion who heard the Prophet."
   ],
   "grader": [
    "Grader",
    "A scholar who judged each hadith of a book: sahih (sound), hasan (good), da'if (weak), and so on. Different scholars can judge the same hadith differently; comparing them shows how strict each one is."
   ],
   "critic": [
    "Critic of narrators (rijal)",
    "A scholar who judged the narrators themselves — their honesty and the accuracy of their memory — in fixed words that rank them, from Companion down to liar (Ibn Hajar uses twelve ranks)."
   ]
  },
